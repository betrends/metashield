# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ── Supabase (database + auth) ──────────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER exposed to the browser. Used for
# admin-level operations (e.g. the contact form writing on behalf of a
# not-yet-signed-in visitor). Keep this out of any NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (real AI Assistant) ───────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Resend (contact form + wizard submission emails) ────────────────────
# resend.com → API Keys. Also verify a sending domain there before this
# works in production (a shared dev sender works for local testing).
RESEND_API_KEY=
# Where submissions/notifications get sent.
NOTIFY_EMAIL=hello@example.com
# The "from" address — must be on a domain verified in Resend.
RESEND_FROM_EMAIL=AccountGuard <notifications@example.com>

# ── Korapay (Account Protection subscription billing only — not case fees,
#    which are paid by bank transfer + receipt review, see lib/portal/bank-details.ts) ──
# dashboard.korapay.com → Settings → API Keys
KORAPAY_PUBLIC_KEY=
# Also doubles as the webhook signing secret (Korapay HMACs the webhook
# payload with your secret key — there's no separate webhook secret).
KORAPAY_SECRET_KEY=

# Base URL of this app — used for Korapay redirect/webhook callback URLs.
# Use your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Admin (confirming case payment receipts) ─────────────────────────────
# The signed-in email allowed to view/confirm submitted payment receipts.
# Server-side enforcement — the actual security boundary.
ADMIN_EMAIL=
# Same value, exposed to the browser only so the portal nav can decide
# whether to show the "Payments" admin link. Never trusted for anything
# security-sensitive — every admin API route re-checks ADMIN_EMAIL itself.
NEXT_PUBLIC_ADMIN_EMAIL=
